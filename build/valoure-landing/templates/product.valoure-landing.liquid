{% comment %}
  Valoure Sleep — Product landing template
  Offer: 1 = 33.95 | 2 = 15% off + free shipping | 3 = 30% off + free shipping
  Add via Online Store > Themes > Edit code > Templates > Add a new template
  (type: product, name: valoure-landing) then paste this file's contents.
  Then assign it to the product: Product page > Theme template > valoure-landing.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
/* =====================================================================
   VALOURE SLEEP — PRODUCT DETAIL PAGE (PDP)
   Scoped to #valoure-pdp so every rule is safe to paste into a Shopify
   section without leaking into the rest of the theme.
   Offer: 1=€33.95 · 2=15% off + free shipping · 3=30% off + free shipping
   Variant IDs are real (see data-variant / data-id attributes).
   ===================================================================== */
#valoure-pdp{
  --lavender:#b7ace0; --plum:#4d3f70; --plum-soft:#7768a3;
  --peach:#f6c9a4; --peach-deep:#eaa876; --cloud:#fbf8fc;
  --ink:#3a3450; --ink-soft:#786f95; --line:#eadcf0;
  font-family:'DM Sans',-apple-system,BlinkMacSystemFont,sans-serif;
  color:var(--ink); background:var(--cloud); line-height:1.55;
  -webkit-font-smoothing:antialiased; overflow-x:hidden;
}
#valoure-pdp *{box-sizing:border-box;}
#valoure-pdp img{max-width:100%; display:block;}
#valoure-pdp a{text-decoration:none; color:inherit;}
#valoure-pdp button{font-family:inherit; cursor:pointer; border:none;}
#valoure-pdp .serif{font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-weight:400;}
#valoure-pdp .wrap{max-width:1080px; margin:0 auto; padding:0 22px;}
#valoure-pdp .wrap-narrow{max-width:720px; margin:0 auto; padding:0 22px;}
#valoure-pdp .eyebrow{font-size:12px; letter-spacing:0.18em; text-transform:uppercase; font-weight:700;}

/* ---------- announcement bar ---------- */
#valoure-pdp .announce{background:var(--plum); color:#fff; text-align:center; font-size:12.5px; letter-spacing:0.04em; padding:9px 16px; font-weight:500;}
#valoure-pdp .announce b{font-weight:700; color:var(--peach);}

/* ---------- header ---------- */
#valoure-pdp .head{position:sticky; top:0; z-index:40; background:rgba(251,248,252,0.9); backdrop-filter:blur(10px); border-bottom:1px solid var(--line);}
#valoure-pdp .head .wrap{display:flex; align-items:center; justify-content:space-between; height:60px;}
#valoure-pdp .logo-word{font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:25px; color:var(--plum); line-height:1;}
#valoure-pdp .logo-word span{font-family:'DM Sans',sans-serif; font-style:normal; font-weight:500; font-size:12px; letter-spacing:0.22em; text-transform:uppercase; color:var(--plum-soft); display:block; margin-top:3px;}
#valoure-pdp .head-cta{background:var(--plum); color:var(--cloud); font-weight:700; font-size:13px; padding:9px 20px; border-radius:999px;}
#valoure-pdp .head-cta:hover{background:var(--plum-soft);}

/* ---------- hero ---------- */
#valoure-pdp .hero{padding:34px 0 20px;}
#valoure-pdp .hero-grid{display:grid; grid-template-columns:1fr 1fr; gap:44px; align-items:start;}

/* gallery */
#valoure-pdp .gallery{position:sticky; top:78px;}
#valoure-pdp .gallery-main{position:relative; border-radius:26px; overflow:hidden; background:linear-gradient(160deg,#efe6f4,#f7e9dd); box-shadow:0 30px 60px -30px rgba(77,63,112,0.5); aspect-ratio:1/1;}
#valoure-pdp .gallery-main img{width:100%; height:100%; object-fit:cover;}
#valoure-pdp .gallery-tag{position:absolute; top:16px; left:16px; background:rgba(255,255,255,0.92); color:var(--plum); font-size:11px; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; padding:7px 13px; border-radius:999px;}
#valoure-pdp .gallery-thumbs{display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:12px;}
#valoure-pdp .thumb{border-radius:14px; overflow:hidden; aspect-ratio:1/1; border:2px solid transparent; background:linear-gradient(160deg,#efe6f4,#f7e9dd); padding:0; position:relative;}
#valoure-pdp .thumb.active{border-color:var(--plum);}
#valoure-pdp .thumb img{width:100%; height:100%; object-fit:cover;}
/* placeholder thumbs (swap these for real photos — see PHOTO BRIEF comment) */
#valoure-pdp .thumb.ph{display:flex; align-items:center; justify-content:center; text-align:center;}
#valoure-pdp .thumb.ph span{font-size:9px; font-weight:700; letter-spacing:0.03em; color:var(--plum-soft); text-transform:uppercase; padding:4px; line-height:1.3;}

/* info panel */
#valoure-pdp .info .eyebrow{color:var(--peach-deep); margin-bottom:10px;}
#valoure-pdp .info h1{font-size:clamp(28px,4.4vw,40px); line-height:1.12; color:var(--plum); margin:0 0 10px; font-weight:700; letter-spacing:-0.01em;}
#valoure-pdp .info .sub{font-size:15.5px; color:var(--ink-soft); margin:0 0 16px; max-width:460px;}
#valoure-pdp .rating{display:flex; align-items:center; gap:10px; margin-bottom:20px;}
#valoure-pdp .stars{display:flex; gap:2px;}
#valoure-pdp .stars svg{width:17px; height:17px; color:var(--peach-deep);}
#valoure-pdp .rating small{font-size:13px; color:var(--ink-soft); font-weight:500;}
#valoure-pdp .rating small b{color:var(--plum);}
#valoure-pdp .hero-bullets{list-style:none; padding:0; margin:0 0 24px; display:grid; gap:9px;}
#valoure-pdp .hero-bullets li{display:flex; gap:10px; align-items:flex-start; font-size:14.5px; color:var(--ink);}
#valoure-pdp .hero-bullets svg{width:18px; height:18px; color:var(--plum); flex:none; margin-top:1px;}

/* bundle selector */
#valoure-pdp .bundle{display:grid; gap:12px; margin-bottom:20px;}
#valoure-pdp .opt{position:relative; display:flex; align-items:center; gap:14px; border:2px solid var(--line); background:#fff; border-radius:18px; padding:16px 18px; transition:border-color .15s, box-shadow .15s; text-align:left;}
#valoure-pdp .opt:hover{border-color:var(--lavender);}
#valoure-pdp .opt.sel{border-color:var(--plum); box-shadow:0 16px 32px -22px rgba(77,63,112,0.55);}
#valoure-pdp .opt-radio{flex:none; width:22px; height:22px; border-radius:50%; border:2px solid var(--line); display:flex; align-items:center; justify-content:center; transition:border-color .15s;}
#valoure-pdp .opt.sel .opt-radio{border-color:var(--plum);}
#valoure-pdp .opt-radio i{width:11px; height:11px; border-radius:50%; background:var(--plum); transform:scale(0); transition:transform .15s;}
#valoure-pdp .opt.sel .opt-radio i{transform:scale(1);}
#valoure-pdp .opt-main{flex:1 1 auto;}
#valoure-pdp .opt-title{font-size:15.5px; font-weight:700; color:var(--plum); display:flex; align-items:center; gap:8px; flex-wrap:wrap;}
#valoure-pdp .opt-sub{font-size:12.5px; color:var(--peach-deep); font-weight:700; margin-top:3px;}
#valoure-pdp .opt-sub.muted{color:var(--ink-soft); font-weight:500;}
#valoure-pdp .opt-price{text-align:right; flex:none;}
#valoure-pdp .opt-now{font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:22px; color:var(--plum); line-height:1;}
#valoure-pdp .opt-was{font-size:12px; color:var(--ink-soft); text-decoration:line-through; margin-top:3px;}
#valoure-pdp .opt-each{font-size:11px; color:var(--ink-soft); margin-top:2px;}
#valoure-pdp .tag{font-size:9.5px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; padding:3px 9px; border-radius:999px; white-space:nowrap;}
#valoure-pdp .tag.pop{background:var(--plum); color:#fff;}
#valoure-pdp .tag.best{background:linear-gradient(135deg,var(--lavender),var(--peach)); color:#fff;}

/* ATC */
#valoure-pdp .atc{display:block; width:100%; text-align:center; background:linear-gradient(135deg,var(--plum),var(--plum-soft)); color:var(--cloud); font-weight:700; font-size:16px; padding:17px 0; border-radius:999px; box-shadow:0 18px 36px -14px rgba(77,63,112,0.6); transition:transform .12s, box-shadow .12s; letter-spacing:0.01em;}
#valoure-pdp .atc:hover{transform:translateY(-2px); box-shadow:0 22px 44px -14px rgba(77,63,112,0.68);}
#valoure-pdp .atc small{display:block; font-weight:500; font-size:12px; opacity:0.85; margin-top:2px;}
#valoure-pdp .atc-sub{text-align:center; font-size:12.5px; color:var(--ink-soft); margin-top:12px; display:flex; align-items:center; justify-content:center; gap:7px; flex-wrap:wrap;}
#valoure-pdp .atc-sub svg{width:14px; height:14px; color:var(--plum-soft);}
#valoure-pdp .pay{display:flex; align-items:center; justify-content:center; gap:8px; margin-top:14px; flex-wrap:wrap;}
#valoure-pdp .pay span{font-size:10px; font-weight:700; color:var(--plum-soft); background:#fff; border:1px solid var(--line); border-radius:6px; padding:4px 9px; letter-spacing:0.03em;}

/* ---------- trust strip ---------- */
#valoure-pdp .strip{border-top:1px solid var(--line); border-bottom:1px solid var(--line); background:#fff; margin-top:30px;}
#valoure-pdp .strip .wrap{display:grid; grid-template-columns:repeat(4,1fr); gap:16px; padding:22px 22px;}
#valoure-pdp .strip-item{display:flex; flex-direction:column; align-items:center; text-align:center; gap:8px;}
#valoure-pdp .strip-item svg{width:24px; height:24px; color:var(--plum);}
#valoure-pdp .strip-item b{font-size:13px; color:var(--plum);}
#valoure-pdp .strip-item small{font-size:11.5px; color:var(--ink-soft);}

/* ---------- section shells ---------- */
#valoure-pdp section{padding:56px 0;}
#valoure-pdp .sec-eyebrow{text-align:center; color:var(--peach-deep); margin-bottom:12px;}
#valoure-pdp .sec-h{font-size:clamp(24px,4.4vw,34px); color:var(--plum); text-align:center; margin:0 auto 14px; max-width:560px; line-height:1.18;}
#valoure-pdp .sec-lead{text-align:center; color:var(--ink-soft); font-size:15.5px; max-width:520px; margin:0 auto 40px;}

/* ---------- problem ---------- */
#valoure-pdp .problem{background:linear-gradient(180deg,var(--cloud),#f1e6f2);}
#valoure-pdp .problem-quote{max-width:600px; margin:0 auto 34px; text-align:center;}
#valoure-pdp .problem-quote p{font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:clamp(22px,4vw,30px); color:var(--plum); line-height:1.35; margin:0;}
#valoure-pdp .pain-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:16px; max-width:840px; margin:0 auto;}
#valoure-pdp .pain{background:#fff; border-radius:20px; padding:24px 20px; text-align:center; box-shadow:0 16px 30px -24px rgba(77,63,112,0.4);}
#valoure-pdp .pain .p-ic{width:46px; height:46px; border-radius:50%; margin:0 auto 14px; background:linear-gradient(160deg,var(--lavender),var(--peach)); display:flex; align-items:center; justify-content:center;}
#valoure-pdp .pain .p-ic svg{width:20px; height:20px; color:#fff;}
#valoure-pdp .pain b{display:block; font-size:15px; color:var(--plum); margin-bottom:6px;}
#valoure-pdp .pain span{font-size:13.5px; color:var(--ink-soft);}

/* ---------- tried everything ---------- */
#valoure-pdp .tried-list{max-width:560px; margin:0 auto 30px; display:grid; gap:12px;}
#valoure-pdp .tried{display:flex; align-items:center; gap:14px; background:#fff; border:1px solid var(--line); border-radius:16px; padding:15px 18px;}
#valoure-pdp .tried .x{flex:none; width:28px; height:28px; border-radius:50%; background:#f6ecec; display:flex; align-items:center; justify-content:center;}
#valoure-pdp .tried .x svg{width:15px; height:15px; color:#c98a8a;}
#valoure-pdp .tried b{font-size:14.5px; color:var(--plum);}
#valoure-pdp .tried span{font-size:13px; color:var(--ink-soft); display:block; margin-top:1px;}
#valoure-pdp .tried-punch{text-align:center; font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:clamp(20px,3.6vw,26px); color:var(--plum); max-width:520px; margin:0 auto;}

/* ---------- mechanism ---------- */
#valoure-pdp .mech{background:linear-gradient(180deg,#f1e6f2,var(--cloud));}
#valoure-pdp .mech-grid{display:grid; grid-template-columns:1fr 1fr; gap:40px; align-items:center; max-width:920px; margin:0 auto;}
#valoure-pdp .mech-photo{border-radius:26px; overflow:hidden; box-shadow:0 30px 56px -28px rgba(77,63,112,0.5); aspect-ratio:4/3; background:linear-gradient(160deg,#efe6f4,#f7e9dd);}
#valoure-pdp .mech-photo img{width:100%; height:100%; object-fit:cover;}
#valoure-pdp .mech-copy h3{font-size:clamp(22px,3.6vw,28px); color:var(--plum); margin:0 0 14px; line-height:1.2;}
#valoure-pdp .mech-copy p{font-size:15px; color:var(--ink-soft); margin:0 0 16px;}
#valoure-pdp .mech-stat{display:flex; gap:22px; margin-top:22px;}
#valoure-pdp .mech-stat div b{display:block; font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:30px; color:var(--peach-deep); line-height:1;}
#valoure-pdp .mech-stat div span{font-size:12px; color:var(--ink-soft);}

/* ---------- benefits ---------- */
#valoure-pdp .ben-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:16px; max-width:900px; margin:0 auto;}
#valoure-pdp .ben{background:linear-gradient(160deg,#fff,#f8f3fb); border-radius:20px; padding:26px 22px; box-shadow:0 14px 28px -24px rgba(77,63,112,0.35);}
#valoure-pdp .ben .b-ic{width:44px; height:44px; border-radius:12px; background:var(--cloud); border:1.5px solid var(--line); display:flex; align-items:center; justify-content:center; margin-bottom:14px;}
#valoure-pdp .ben .b-ic svg{width:20px; height:20px; color:var(--plum);}
#valoure-pdp .ben b{display:block; font-size:15.5px; color:var(--plum); margin-bottom:6px;}
#valoure-pdp .ben span{font-size:13.5px; color:var(--ink-soft);}

/* ---------- comparison ---------- */
#valoure-pdp .compare{background:linear-gradient(180deg,var(--cloud),#f1e6f2);}
#valoure-pdp .ctable{max-width:720px; margin:0 auto; background:#fff; border-radius:22px; overflow:hidden; box-shadow:0 24px 46px -30px rgba(77,63,112,0.45);}
#valoure-pdp .crow{display:grid; grid-template-columns:1.6fr 1fr 1fr 1fr 1fr; align-items:center;}
#valoure-pdp .crow:not(:last-child){border-bottom:1px solid var(--line);}
#valoure-pdp .crow.head{background:var(--plum); color:#fff;}
#valoure-pdp .crow.head > div{padding:16px 8px; font-size:11.5px; font-weight:700; text-align:center; letter-spacing:0.02em;}
#valoure-pdp .crow.head > div:first-child{text-align:left; padding-left:20px;}
#valoure-pdp .crow.head .us{background:var(--peach-deep);}
#valoure-pdp .crow .rlabel{padding:15px 20px; font-size:13.5px; font-weight:500; color:var(--ink); text-align:left;}
#valoure-pdp .crow .cell{padding:15px 8px; text-align:center; display:flex; justify-content:center;}
#valoure-pdp .crow .cell.us{background:#fbf3ea;}
#valoure-pdp .crow .cell svg{width:19px; height:19px;}
#valoure-pdp .crow .cell .yes{color:#5a9e78;}
#valoure-pdp .crow .cell .no{color:#cf9a9a;}
#valoure-pdp .compare-note{text-align:center; font-size:12px; color:var(--ink-soft); margin-top:16px;}

/* ---------- how to use ---------- */
#valoure-pdp .steps{display:grid; grid-template-columns:repeat(3,1fr); gap:20px; max-width:820px; margin:0 auto;}
#valoure-pdp .stepc{text-align:center;}
#valoure-pdp .stepc .num{width:52px; height:52px; margin:0 auto 16px; border-radius:50%; background:var(--plum); color:#fff; font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:24px; display:flex; align-items:center; justify-content:center;}
#valoure-pdp .stepc b{display:block; font-size:16px; color:var(--plum); margin-bottom:6px;}
#valoure-pdp .stepc span{font-size:13.5px; color:var(--ink-soft);}

/* ---------- reviews ---------- */
#valoure-pdp .reviews{background:linear-gradient(180deg,#f1e6f2,var(--cloud));}
#valoure-pdp .rev-head{display:flex; flex-direction:column; align-items:center; gap:8px; margin-bottom:36px;}
#valoure-pdp .rev-head .big{font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:40px; color:var(--plum); line-height:1;}
#valoure-pdp .rev-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:18px; max-width:960px; margin:0 auto;}
#valoure-pdp .rev{background:#fff; border-radius:20px; padding:24px 22px; box-shadow:0 16px 32px -26px rgba(77,63,112,0.4); display:flex; flex-direction:column;}
#valoure-pdp .rev .stars{margin-bottom:12px;}
#valoure-pdp .rev p{font-size:14px; color:var(--ink); margin:0 0 16px; flex:1;}
#valoure-pdp .rev p b{color:var(--plum);}
#valoure-pdp .rev .who{display:flex; align-items:center; gap:11px;}
#valoure-pdp .rev .av{width:38px; height:38px; border-radius:50%; background:linear-gradient(160deg,var(--lavender),var(--peach)); color:#fff; font-weight:700; font-size:15px; display:flex; align-items:center; justify-content:center;}
#valoure-pdp .rev .who b{font-size:13.5px; color:var(--plum); display:block;}
#valoure-pdp .rev .who small{font-size:11.5px; color:#5a9e78; font-weight:700; display:flex; align-items:center; gap:4px;}
#valoure-pdp .rev .who small svg{width:11px; height:11px;}

/* ---------- offer recap ---------- */
#valoure-pdp .offer{scroll-margin-top:70px;}
#valoure-pdp .offer-box{max-width:560px; margin:0 auto; background:#fff; border-radius:26px; padding:34px 30px; box-shadow:0 30px 60px -32px rgba(77,63,112,0.5); border:1px solid var(--line);}
#valoure-pdp .offer-box .bundle{margin-bottom:18px;}
#valoure-pdp .offer-box h2{text-align:center; font-size:clamp(22px,4vw,30px); color:var(--plum); margin:0 0 6px;}
#valoure-pdp .offer-box .lead{text-align:center; color:var(--ink-soft); font-size:14px; margin:0 0 26px;}

/* ---------- founder ---------- */
#valoure-pdp .founder-box{max-width:640px; margin:0 auto; background:linear-gradient(160deg,#fff,#f8f3fb); border-radius:26px; padding:40px 34px; text-align:center; box-shadow:0 20px 40px -30px rgba(77,63,112,0.4);}
#valoure-pdp .founder-box p{font-size:15.5px; color:var(--ink); margin:0 0 16px; line-height:1.6;}
#valoure-pdp .founder-box p.serif{font-size:clamp(19px,3.4vw,24px); color:var(--plum); line-height:1.4;}
#valoure-pdp .founder-sign{font-family:'Instrument Serif',Georgia,serif; font-style:italic; font-size:22px; color:var(--plum); margin-top:8px;}
#valoure-pdp .founder-sign span{display:block; font-family:'DM Sans',sans-serif; font-style:normal; font-size:12px; letter-spacing:0.1em; text-transform:uppercase; color:var(--ink-soft); margin-top:4px;}

/* ---------- guarantee ---------- */
#valoure-pdp .guarantee{background:linear-gradient(160deg,var(--lavender) 0%,#d9bfd9 50%,var(--peach) 100%);}
#valoure-pdp .guar-box{max-width:600px; margin:0 auto; text-align:center;}
#valoure-pdp .guar-seal{width:88px; height:88px; margin:0 auto 20px; border-radius:50%; background:#fff; display:flex; align-items:center; justify-content:center; box-shadow:0 16px 34px -16px rgba(77,63,112,0.5);}
#valoure-pdp .guar-seal svg{width:42px; height:42px; color:var(--plum);}
#valoure-pdp .guar-box h2{font-size:clamp(24px,4.4vw,32px); color:var(--plum); margin:0 0 14px;}
#valoure-pdp .guar-box p{font-size:15.5px; color:#5a4a63; margin:0 auto; max-width:480px;}

/* ---------- faq ---------- */
#valoure-pdp .faq-list{max-width:640px; margin:0 auto; display:grid; gap:12px;}
#valoure-pdp details{background:#fff; border:1px solid var(--line); border-radius:16px; padding:4px 22px; transition:box-shadow .15s;}
#valoure-pdp details[open]{box-shadow:0 16px 32px -26px rgba(77,63,112,0.4);}
#valoure-pdp summary{cursor:pointer; padding:16px 0; font-size:15px; font-weight:700; color:var(--plum); list-style:none; display:flex; justify-content:space-between; align-items:center; gap:16px;}
#valoure-pdp summary::-webkit-details-marker{display:none;}
#valoure-pdp summary::after{content:"+"; font-size:22px; color:var(--plum-soft); font-weight:400; flex:none; transition:transform .2s;}
#valoure-pdp details[open] summary::after{transform:rotate(45deg);}
#valoure-pdp details p{margin:0 0 18px; font-size:14px; color:var(--ink-soft);}

/* ---------- final ---------- */
#valoure-pdp .final{background:linear-gradient(160deg,var(--peach) 0%,#f0b48a 100%); text-align:center;}
#valoure-pdp .final h2{font-size:clamp(26px,5vw,38px); color:var(--plum); max-width:520px; margin:0 auto 14px; line-height:1.15;}
#valoure-pdp .final p{max-width:440px; margin:0 auto 28px; color:#5f4a3c; font-size:15.5px;}
#valoure-pdp .final .atc{max-width:360px; margin:0 auto; background:linear-gradient(135deg,var(--plum),var(--plum-soft));}
