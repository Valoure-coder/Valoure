<script>
(function(){
  var root = document.getElementById('valoure-pdp');
  if(!root) return;

  // ---- state / selected option ----
  var state = { qty:2, id:'65158753321309', now:'57.72', was:'67.90', each:'28.86' };

  var subByQty = {
    1: { sub:'Try it risk-free tonight', title:'1 Sleep Mask', small:'Risk-free · 60-night guarantee' },
    2: { sub:'Save 15% + free shipping', title:'2 Sleep Masks · Most Popular', small:'Most popular · Save 15% + free shipping' },
    3: { sub:'Save 30% + free shipping', title:'3 Sleep Masks · Best Value', small:'Best value · Save 30% + free shipping' }
  };

  function fmt(v){ return '€' + Number(v).toFixed(2); }

  function apply(){
    // sync every .opt in every bundle group to the selected qty
    root.querySelectorAll('.bundle .opt').forEach(function(o){
      o.classList.toggle('sel', o.getAttribute('data-qty') === String(state.qty));
    });
    var href = '/cart/add?id=' + state.id + '&quantity=1';
    var meta = subByQty[state.qty];

    // main ATC buttons (hero, offer, final)
    ['atcBtn','atcBtn2','atcBtn3'].forEach(function(bid){
      var b = document.getElementById(bid);
      if(!b) return;
      b.setAttribute('href', href);
      b.innerHTML = 'Add to cart — ' + fmt(state.now) + '<small>' + meta.small + '</small>';
    });

    // sticky bar
    var sBtn = document.getElementById('sBtn'); if(sBtn) sBtn.setAttribute('href', href);
    var sTitle = document.getElementById('sTitle'); if(sTitle) sTitle.textContent = meta.title;
    var sSub = document.getElementById('sSub'); if(sSub) sSub.textContent = meta.sub;
    var sPrice = document.getElementById('sPrice'); if(sPrice) sPrice.textContent = fmt(state.now);
  }

  // click handlers for both bundle groups
  root.querySelectorAll('.bundle .opt').forEach(function(o){
    o.addEventListener('click', function(){
      state.qty = Number(o.getAttribute('data-qty'));
      state.id  = o.getAttribute('data-id');
      state.now = o.getAttribute('data-now');
      state.was = o.getAttribute('data-was');
      state.each= o.getAttribute('data-each');
      apply();
    });
  });

  // ---- gallery thumbnails ----
  var mainImg = document.getElementById('mainImg');
  root.querySelectorAll('.thumb').forEach(function(t){
    t.addEventListener('click', function(){
      var src = t.getAttribute('data-src');
      root.querySelectorAll('.thumb').forEach(function(x){ x.classList.remove('active'); });
      t.classList.add('active');
      if(src && mainImg){ mainImg.setAttribute('src', src); }
    });
  });

  // ---- sticky ATC bar: show after hero scrolls past ----
  var stickyBar = document.getElementById('stickyBar');
  var hero = root.querySelector('.hero');
  function onScroll(){
    if(!hero || !stickyBar) return;
    var past = hero.getBoundingClientRect().bottom < 0;
    // hide again when the offer box is in view (avoid double CTA)
    var offer = document.getElementById('offer');
    var offerVisible = offer && offer.getBoundingClientRect().top < window.innerHeight && offer.getBoundingClientRect().bottom > 0;
    stickyBar.classList.toggle('show', past && !offerVisible);
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll);

  // ---- rotating announcement ----
  var msgs = [
    '✦ Free shipping on 2+ masks &nbsp;·&nbsp; <b>60-night calm-sleep guarantee</b> &nbsp;·&nbsp; Loved by 4,000+ tired-but-wired minds',
    '🌙 For minds that won\'t switch off &nbsp;·&nbsp; <b>No apps. No pills. Just gentle weight.</b>',
    '✦ Ships in 24h from the EU &nbsp;·&nbsp; <b>Try it for 60 nights, risk-free</b>'
  ];
  var ann = document.getElementById('announce'), mi = 0;
  if(ann){ setInterval(function(){ mi=(mi+1)%msgs.length; ann.style.opacity=0; setTimeout(function(){ ann.innerHTML=msgs[mi]; ann.style.opacity=1; },250); }, 4200); ann.style.transition='opacity .25s'; }

  apply();
  onScroll();
})();
</script>
